{
    "manifest_version": 3,
    "name": "Semantic History Search",
    "version": "1.0",
    "description": "Search your browsing history semantically using WinnowDB",
    "permissions": [
        "history",
        "storage"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    }
}